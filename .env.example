SITE_PASSWORD=ganti-dengan-password-situs
GD_CLIENT_ID=ganti-dengan-google-client-id
GD_CLIENT_SECRET=ganti-dengan-google-client-secret
GD_REFRESH_TOKEN=ganti-dengan-google-refresh-token
GD_ROOT_FOLDER=ganti-dengan-id-folder-root-google-drive
